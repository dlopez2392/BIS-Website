# Copy to .env.local. Every value here has a working default or is optional;
# the site builds and runs with none of them set.

# --- BIS Platform (app.bis-rgv.com) --------------------------------------
# Hosts the contact form and the assessment scheduler on /contact. Defaults
# are the live BIS account's opaque public ids; override to point a preview
# at a test account. The ids are links, not secrets.
# NEXT_PUBLIC_BIS_PLATFORM_ORIGIN=https://app.bis-rgv.com
# NEXT_PUBLIC_BIS_FORM_ID_EN=i994hbegzxng
# NEXT_PUBLIC_BIS_FORM_ID_ES=yqj4fywpjptn
# NEXT_PUBLIC_BIS_BOOKING_ID=7t36x3a3izen

# --- Chat assistant --------------------------------------------------------
# NEXT_PUBLIC_AI_ENABLED=true
# DEEPSEEK_API_KEY=
# Shared Upstash store (either spelling; the Vercel Marketplace injects KV_*).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Resource downloads and chat-captured leads ---------------------------
# DATABASE_URL=
# RESEND_API_KEY=
# CONTACT_FROM=
# CONTACT_REPLY_TO=
# CONTACT_NOTIFY_TO=

# --- Misc ------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://bis-rgv.com

# WhatsApp Business number for the message button, in any readable form
# (+1 956 506 1545, 956-506-1545, 19565061545). Every WhatsApp button on the
# site renders only when this is set, so leaving it blank hides the channel
# rather than linking to a chat nobody answers.
# NEXT_PUBLIC_WHATSAPP_NUMBER=

# "Talk to Sofía" — the in-browser voice demo on the trust page.
# Both must be set or /api/sofia/ticket returns 503 and the panel shows its
# "call the number instead" message. This site never holds an OpenAI key: it
# signs a short-lived ticket, and the PLATFORM mints the session credential.
#
# Byte-identical to SOFIA_WEB_SECRET in the bis-platform project. Any long
# random string. Sensitive in Vercel.
SOFIA_WEB_SECRET=
# The platform endpoint that verifies the ticket and mints the session.
NEXT_PUBLIC_SOFIA_SESSION_URL=https://app.bis-rgv.com/api/voice/web/session
