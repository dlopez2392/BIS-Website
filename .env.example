# Copy to .env.local. Every value here has a working default or is optional;
# the site builds and runs with none of them set.

# --- BIS Platform (app.bis-rgv.com) --------------------------------------
# Hosts the contact form and the assessment scheduler on /contact. Defaults
# are the live BIS account's opaque public ids; override to point a preview
# at a test account. The ids are links, not secrets.
# NEXT_PUBLIC_BIS_PLATFORM_ORIGIN=https://app.bis-rgv.com
# NEXT_PUBLIC_BIS_FORM_ID_EN=i994hbegzxng
# NEXT_PUBLIC_BIS_FORM_ID_ES=yqj4fywpjptn
# NEXT_PUBLIC_BIS_BOOKING_ID=7t36x3a3izen

# --- Chat assistant --------------------------------------------------------
# NEXT_PUBLIC_AI_ENABLED=true
# DEEPSEEK_API_KEY=
# Shared Upstash store (either spelling; the Vercel Marketplace injects KV_*).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Resource downloads and chat-captured leads ---------------------------
# DATABASE_URL=
# RESEND_API_KEY=
# CONTACT_FROM=
# CONTACT_REPLY_TO=
# CONTACT_NOTIFY_TO=

# --- Misc ------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://bis-rgv.com
